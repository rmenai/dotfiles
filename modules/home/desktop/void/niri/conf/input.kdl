input {
    focus-follows-mouse
    workspace-auto-back-and-forth

    touchpad {
        tap
        dwt
        natural-scroll
        scroll-factor 0.4
    }

    mouse {
        accel-speed -1.0
    }
    trackball {
        accel-speed -1.0
    }
    trackpoint {
        accel-speed -1.0
    }
}
